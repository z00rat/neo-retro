    "format": "prettier --write .",
    "lint": "eslint .",
    "knip": "knip",
    "compare-registry": "bun scripts/compare_registry.js",
    "sort-registry": "bun scripts/sort_registry.js",
    "generate-themes": "bun scripts/generate-themes.ts"
  },
